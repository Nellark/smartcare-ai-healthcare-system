# Copy this to a real .env file and set your SMTP credentials.
# The API reads these values before falling back to appsettings.json.
SMARTCARE_SMTP_HOST=smtp.gmail.com
SMARTCARE_SMTP_PORT=587
SMARTCARE_SMTP_ENABLE_SSL=true
SMARTCARE_SMTP_USERNAME=your-email@gmail.com
SMARTCARE_SMTP_PASSWORD=your-app-password
SMARTCARE_SMTP_FROM_NAME=SmartCare
SMARTCARE_SMTP_FROM_EMAIL=your-email@gmail.com
SMARTCARE_FRONTEND_URL=http://localhost:4200
